<Window x:Class="VoidClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoidClip"
        xmlns:ctrl="clr-namespace:VoidClip.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VoidClip" Height="810" Width="1240" MinWidth="900" MinHeight="600"
        WindowStyle="None" Background="{StaticResource Void0}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:EmptyToCollapsed x:Key="EmptyHide"/>
        <local:BoolToVisibility x:Key="BoolVis"/>
        <local:PrettyHotkey x:Key="Pretty"/>
        <local:HexToBrush x:Key="HexBrush"/>
        <local:ClipAccent x:Key="Accent"/>
        <local:CategoryName x:Key="CatName"/>

        <!-- ══════════ SOUNDBOARD PAD ══════════ -->
        <DataTemplate x:Key="PadTemplate">
            <Border x:Name="Pad"
                    Width="{Binding PadWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="{Binding PadHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                    Margin="0,0,11,11" CornerRadius="12" Background="{StaticResource PadGradient}"
                    BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonDown="Pad_Down" MouseLeftButtonUp="Pad_Click"
                    MouseRightButtonUp="Pad_RightClick">
                <Border.ToolTip>
                    <StackPanel MaxWidth="280">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock Foreground="{StaticResource TextMute}" FontSize="11" Margin="0,3,0,0">
                            <Run Text="{Binding CategoryId, Converter={StaticResource CatName}, Mode=OneWay}"/>
                            <Run Text="·"/>
                            <Run Text="{Binding DurationText, Mode=OneWay}"/>
                            <Run Text="·"/>
                            <Run Text="{Binding Created, StringFormat='{}{0:dd MMM HH:mm}', Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Click to fire · double-click to edit · right-click for more"
                                   Foreground="{StaticResource TextMute}" FontSize="10.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border.ToolTip>

                <Grid Margin="12,10,12,9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- accent stripe + name -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" Height="15" CornerRadius="2" VerticalAlignment="Center"
                                Background="{Binding Converter={StaticResource Accent}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                                   Foreground="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource RedGlow}" VerticalAlignment="Center"
                                   Visibility="{Binding Favorite, Converter={StaticResource BoolVis}}"/>
                    </Grid>

                    <!-- waveform -->
                    <ctrl:WaveformView Grid.Row="1" Peaks="{Binding Peaks}" Compact="True" Margin="0,8,0,6"
                                       Visibility="{Binding ShowPadWaves, RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolVis}}"/>

                    <!-- footer: duration + hotkey -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DurationText}" FontSize="10.5"
                                   Foreground="{StaticResource TextMute}" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" CornerRadius="4" Padding="5,2" Background="#33A855F7"
                                Visibility="{Binding Hotkey, Converter={StaticResource EmptyHide}}">
                            <TextBlock Text="{Binding Hotkey, Converter={StaticResource Pretty}}" FontSize="9.5"
                                       Foreground="{StaticResource PurpleGlow}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <!-- playing overlay -->
                    <Border Grid.RowSpan="3" Margin="-12,-10,-12,-9" CornerRadius="12" IsHitTestVisible="False"
                            BorderBrush="{StaticResource RedGlow}" BorderThickness="1.5" Background="#22FF2E63"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}"/>

                    <!-- selection overlay -->
                    <Border Grid.RowSpan="3" Margin="-12,-10,-12,-9" CornerRadius="12" IsHitTestVisible="False"
                            BorderBrush="{StaticResource BlueGlow}" BorderThickness="2" Background="#263B82F6"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}">
                        <Border Width="19" Height="19" CornerRadius="10" Background="{StaticResource Blue}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0">
                            <Path Data="M 2.5 5.5 L 5 8.5 L 10 2" Stroke="White" StrokeThickness="1.8"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="Pad" Property="Background" Value="{StaticResource PadGradientActive}"/>
                    <Setter TargetName="Pad" Property="Effect" Value="{StaticResource GlowRed}"/>
                </DataTrigger>
                <Trigger SourceName="Pad" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Pad" Property="Background" Value="{StaticResource PadGradientHover}"/>
                    <Setter TargetName="Pad" Property="BorderBrush" Value="{StaticResource Purple}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ══════════ CATEGORY ROW ══════════ -->
        <DataTemplate x:Key="CategoryTemplate">
            <Border x:Name="Row" CornerRadius="7" Padding="9,7" Margin="0,1" Background="Transparent"
                    Cursor="Hand" MouseLeftButtonUp="Category_Click" MouseRightButtonUp="Category_RightClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{Binding Color, Converter={StaticResource HexBrush}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="9,0,0,0" FontSize="12.5"
                               Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11"
                               Foreground="{StaticResource TextMute}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#22A855F7"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#3DA855F7"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ══════════ BACKDROP ══════════ -->
        <Rectangle Fill="{StaticResource AppBackdrop}"/>
        <Rectangle x:Name="BloomA" Fill="{StaticResource PurpleBloom}" Opacity="0.85"
                   Width="900" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="-260,-220,0,0" IsHitTestVisible="False"/>
        <Rectangle x:Name="BloomB" Fill="{StaticResource RedBloom}" Opacity="0.7"
                   Width="1000" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,-300,-280" IsHitTestVisible="False"/>
        <Rectangle x:Name="BloomC" Fill="{StaticResource BlueBloom}" Opacity="0.55"
                   Width="760" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,-260,-220,0" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════ TITLE BAR ══════════ -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarGradient}"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="13,0,0,0" VerticalAlignment="Center">
                        <Border Width="15" Height="15" CornerRadius="4" Background="{StaticResource AccentGradient}"/>
                        <TextBlock Text="VOIDCLIP" Margin="9,0,0,0" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <Border Width="1" Height="13" Background="{StaticResource Stroke}" Margin="11,0"/>
                        <TextBlock x:Name="TitleHint" Text="instant voice-channel clipper" FontSize="11"
                                   Foreground="{StaticResource TextMute}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Width="34" Height="30" Click="Settings_Click"
                                ToolTip="Settings" FontFamily="Segoe MDL2 Assets" Content="&#xE713;"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimise"/>
                        <Button x:Name="MaxBtn" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Maximise"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════ CLIP STRIP ══════════ -->
            <Border Grid.Row="1" Background="#66100C1B" BorderBrush="{StaticResource StrokeSoft}"
                    BorderThickness="0,0,0,1" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- big clip button -->
                    <Button Grid.Column="0" Style="{StaticResource AccentButton}" Click="ClipNow_Click"
                            Padding="20,0" Height="58" MinWidth="196">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C8;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ClipBtnTitle" Text="CLIP LAST 15s" FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="ClipBtnHint" Text="Ctrl+Alt+C" FontSize="10.5" Opacity="0.8" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- quick lengths -->
                    <StackPanel Grid.Column="1" x:Name="QuickPanel" Orientation="Horizontal" Margin="12,0,0,0"
                                VerticalAlignment="Center"/>

                    <!-- capture status -->
                    <Border Grid.Column="2" Margin="20,0,16,0" MaxWidth="430" HorizontalAlignment="Left"
                            Background="#4D0B0813" CornerRadius="9" Padding="13,8"
                            BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="RecDot" Grid.Column="0" Width="8" Height="8" Fill="{StaticResource TextMute}"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="CaptureLabel" Grid.Column="1" Text="Capture stopped" Margin="8,0,0,0"
                                           FontSize="11.5" Foreground="{StaticResource TextDim}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BufferLabel" Grid.Column="2" Text="0s" FontSize="10.5" Margin="10,0,0,0"
                                           Foreground="{StaticResource TextMute}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,7,0,0" Height="5">
                                <Border Background="#FF1B1629" CornerRadius="3"/>
                                <Border x:Name="LevelBar" Background="{StaticResource MeterGradient}" CornerRadius="3"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- search + sort -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="196">
                            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="30,7,9,7"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource TextMute}" Margin="11,0,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search clips…" Foreground="{StaticResource TextMute}"
                                       FontSize="12" Margin="31,0,0,0" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <ComboBox x:Name="SortBox" Width="146" Margin="9,0,0,0" SelectionChanged="Sort_Changed">
                            <ComboBoxItem Content="Newest first"/>
                            <ComboBoxItem Content="Oldest first"/>
                            <ComboBoxItem Content="Name A–Z"/>
                            <ComboBoxItem Content="Name Z–A"/>
                            <ComboBoxItem Content="Most played"/>
                            <ComboBoxItem Content="Longest first"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════ UPDATE BANNER ══════════ -->
            <Border x:Name="UpdateBanner" Grid.Row="2" Visibility="Collapsed" Padding="16,10"
                    Background="#4014091F" BorderBrush="#66A855F7" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,13,0"
                            Background="{StaticResource AccentGradientWide}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle" Text="Update available" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock x:Name="UpdateBody" Text="" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
                        <Grid x:Name="UpdateProgressTrack" Height="4" Margin="0,7,0,0" Visibility="Collapsed"
                              HorizontalAlignment="Left" Width="260">
                            <Border Background="#FF1B1629" CornerRadius="2"/>
                            <Border x:Name="UpdateProgressFill" Background="{StaticResource AccentGradientWide}"
                                    CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UpdateNotesBtn" Style="{StaticResource GhostButton}" Content="Release notes"
                                Padding="12,7" Click="UpdateNotes_Click"/>
                        <Button x:Name="UpdateActionBtn" Style="{StaticResource AccentButton}" Content="Install"
                                Margin="8,0,0,0" Padding="18,7" Click="UpdateAction_Click"/>
                        <Button x:Name="UpdateDismissBtn" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="6,0,0,0"
                                ToolTip="Dismiss" Click="UpdateDismiss_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════ BODY ══════════ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="238"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarGradient}"
                        BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,1,0">
                    <Grid Margin="13,15,11,13">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="LIBRARY" Style="{StaticResource SectionLabel}"/>

                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <Border x:Name="FilterAll" CornerRadius="7" Padding="9,7" Cursor="Hand"
                                    MouseLeftButtonUp="FilterAll_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="All clips" Margin="9,0,0,0" FontSize="12.5"
                                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AllCount" Grid.Column="2" Text="0" FontSize="11"
                                               Foreground="{StaticResource TextMute}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border x:Name="FilterFav" CornerRadius="7" Padding="9,7" Cursor="Hand"
                                    MouseLeftButtonUp="FilterFav_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE735;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" Foreground="{StaticResource RedGlow}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Favourites" Margin="9,0,0,0" FontSize="12.5"
                                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FavCount" Grid.Column="2" Text="0" FontSize="11"
                                               Foreground="{StaticResource TextMute}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border x:Name="FilterNone" CornerRadius="7" Padding="9,7" Cursor="Hand"
                                    MouseLeftButtonUp="FilterNone_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" Foreground="{StaticResource TextMute}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Uncategorised" Margin="9,0,0,0" FontSize="12.5"
                                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NoneCount" Grid.Column="2" Text="0" FontSize="11"
                                               Foreground="{StaticResource TextMute}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <DockPanel Grid.Row="2" LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                                <TextBlock Text="CATEGORIES" Style="{StaticResource SectionLabel}" Margin="0"/>
                                <Button Style="{StaticResource IconButton}" Width="22" Height="22" Content="+"
                                        FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-4,0,0" Click="AddCategory_Click" ToolTip="New category"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="CategoryList" ItemTemplate="{StaticResource CategoryTemplate}"/>
                            </ScrollViewer>
                        </DockPanel>

                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <Border Height="1" Background="{StaticResource StrokeSoft}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="StorageLabel" Text="—" Style="{StaticResource Hint}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Import audio as pads" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" Click="Import_Click"
                                    ToolTip="Bring WAV, MP3, OGG, FLAC, M4A or WMA files in as clips (Ctrl+I)"/>
                            <Button Style="{StaticResource GhostButton}" Content="Open clips folder" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" Click="OpenFolder_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- board -->
                <Grid Grid.Column="1">
                    <ScrollViewer x:Name="BoardScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="18,16,8,16">
                        <ItemsControl x:Name="Board" ItemTemplate="{StaticResource PadTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- selection actions -->
                    <Border x:Name="SelectionBar" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,18" Visibility="Collapsed" CornerRadius="11" Padding="15,10"
                            Background="#F2140F26" BorderBrush="{StaticResource Blue}" BorderThickness="1"
                            Effect="{StaticResource PanelShadow}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="19" Height="19" CornerRadius="10" Background="{StaticResource Blue}"
                                    VerticalAlignment="Center">
                                <Path Data="M 2.5 5.5 L 5 8.5 L 10 2" Stroke="White" StrokeThickness="1.8"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <TextBlock x:Name="SelectionCount" Text="0 selected" Margin="10,0,4,0" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                       VerticalAlignment="Center"/>
                            <Border Width="1" Background="{StaticResource Stroke}" Margin="12,2"/>
                            <Button Style="{StaticResource GhostButton}" Content="Move to…" Padding="13,7"
                                    Click="SelMove_Click" ToolTip="Put all selected clips in a category"/>
                            <Button Style="{StaticResource GhostButton}" Content="Export…" Margin="7,0,0,0"
                                    Padding="13,7" Click="SelExport_Click"
                                    ToolTip="Export every selected clip into one folder"/>
                            <Button x:Name="SelDeleteBtn" Style="{StaticResource DangerButton}" Content="Delete"
                                    Margin="7,0,0,0" Padding="15,7" Click="SelDelete_Click"/>
                            <Border Width="1" Background="{StaticResource Stroke}" Margin="12,2"/>
                            <Button Style="{StaticResource GhostButton}" Content="Clear" Padding="12,7"
                                    Click="SelClear_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- empty state -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="440" Visibility="Collapsed">
                        <Border Width="62" Height="62" CornerRadius="18" Background="{StaticResource AccentGradient}"
                                Opacity="0.9" HorizontalAlignment="Center" Effect="{StaticResource GlowPurple}">
                            <TextBlock Text="&#xE7C8;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="Nothing clipped yet" Style="{StaticResource H1}"
                                   HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        <TextBlock x:Name="EmptyBody" Style="{StaticResource Body}" TextAlignment="Center" Margin="0,9,0,0"
                                   Text="VoidClip is holding the last few minutes of your speakers in memory. When someone says something worth keeping, hit the clip hotkey — it lands here as a pad you can fire straight back."/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ══════════ BOTTOM BAR ══════════ -->
            <Border Grid.Row="4" Background="#99100C1B" BorderBrush="{StaticResource StrokeSoft}"
                    BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                        <TextBlock Text="OUT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMute}"
                                   Margin="8,0,7,0" VerticalAlignment="Center"/>
                        <Slider x:Name="MasterVol" Width="112" Minimum="0" Maximum="1.5" Value="0.85"
                                ValueChanged="Volume_Changed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MasterVolLabel" Text="85%" FontSize="10.5" Width="34" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextMute}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <CheckBox x:Name="MonitorChk" Content="Monitor" Click="Monitor_Changed" VerticalAlignment="Center"/>
                        <Slider x:Name="MonitorVol" Width="92" Minimum="0" Maximum="1.5" Value="0.6" Margin="10,0,0,0"
                                ValueChanged="Volume_Changed" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="OutputLabel" Grid.Column="2" Margin="20,0" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource TextMute}"
                               TextTrimming="CharacterEllipsis" Text="—"/>

                    <TextBlock x:Name="PlayingLabel" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0"
                               FontSize="11" Foreground="{StaticResource TextMute}" Text=""/>

                    <Button Grid.Column="4" Style="{StaticResource DangerButton}" Click="StopAll_Click"
                            Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StopAllLabel" Text="Stop all" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ TOAST ══════════ -->
        <Border x:Name="Toast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,124,0,0"
                CornerRadius="10" Padding="17,11" Background="#F2160F28" BorderBrush="{StaticResource Purple}"
                BorderThickness="1" Opacity="0" IsHitTestVisible="False" Effect="{StaticResource PanelShadow}">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" CornerRadius="2" Background="{StaticResource AccentGradient}" Margin="0,0,11,0"/>
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" Text="Clipped" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}"/>
                    <TextBlock x:Name="ToastBody" Text="" FontSize="11" Foreground="{StaticResource TextDim}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
