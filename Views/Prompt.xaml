<Window x:Class="VoidClip.Views.Prompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" SizeToContent="Height"
        Width="420" Background="Transparent" AllowsTransparency="True"
        TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="13" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Purple}"
            BorderThickness="1" Effect="{StaticResource PanelShadow}" Margin="14">
        <Grid>
            <Rectangle Fill="{StaticResource PurpleBloom}" Opacity="0.5" IsHitTestVisible="False"
                       RadiusX="13" RadiusY="13"/>
            <StackPanel Margin="22,20,22,18">
                <Border Height="3" CornerRadius="2" Background="{StaticResource AccentGradientWide}"
                        HorizontalAlignment="Left" Width="46" Margin="0,0,0,13"/>
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Text="Rename"/>
                <TextBlock x:Name="MessageText" Style="{StaticResource Body}" Margin="0,7,0,0"/>
                <TextBox x:Name="Input" Margin="0,15,0,0" Height="36"
                         KeyDown="Input_KeyDown"/>
                <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,19,0,0">
                    <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" Content="Cancel"
                            Padding="18,8" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Style="{StaticResource AccentButton}" Content="OK" Margin="9,0,0,0"
                            Padding="24,8" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
