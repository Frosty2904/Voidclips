<Window x:Class="VoidClip.Views.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" SizeToContent="Height"
        Width="440" Background="Transparent" AllowsTransparency="True"
        TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="13" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Purple}"
            BorderThickness="1" Effect="{StaticResource PanelShadow}" Margin="14">
        <Grid>
            <Rectangle Fill="{StaticResource RedBloom}" Opacity="0.4" IsHitTestVisible="False"
                       RadiusX="13" RadiusY="13"/>
            <StackPanel Margin="22,20,22,18">
                <Border Height="3" CornerRadius="2" Background="{StaticResource AccentGradientWide}"
                        HorizontalAlignment="Left" Width="46" Margin="0,0,0,13"/>
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Text="Assign hotkey"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,7,0,0"
                           Text="Press the combination you want. It works anywhere in Windows, so pick something Discord and your games don't already use."/>

                <Border Margin="0,17,0,0" Height="62" CornerRadius="10" Background="#FF0B0813"
                        BorderBrush="{StaticResource Purple}" BorderThickness="1">
                    <TextBlock x:Name="GestureText" Text="Waiting for keys…" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource PurpleGlow}"/>
                </Border>
                <TextBlock x:Name="WarnText" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Foreground="{StaticResource RedGlow}" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,19,0,0">
                    <Button Style="{StaticResource DangerButton}" Content="Clear" Padding="16,8" Click="Clear_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Padding="16,8" Margin="9,0,0,0"
                            Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Style="{StaticResource AccentButton}" Content="Assign" Margin="9,0,0,0"
                            Padding="22,8" IsEnabled="False" Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
