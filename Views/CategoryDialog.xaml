<Window x:Class="VoidClip.Views.CategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" SizeToContent="Height"
        Width="430" Background="Transparent" AllowsTransparency="True"
        TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="13" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Purple}"
            BorderThickness="1" Effect="{StaticResource PanelShadow}" Margin="14">
        <Grid>
            <Rectangle Fill="{StaticResource PurpleBloom}" Opacity="0.5" IsHitTestVisible="False"
                       RadiusX="13" RadiusY="13"/>
            <StackPanel Margin="22,20,22,18">
                <Border Height="3" CornerRadius="2" Background="{StaticResource AccentGradientWide}"
                        HorizontalAlignment="Left" Width="46" Margin="0,0,0,13"/>
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Text="New category"/>

                <TextBlock Text="NAME" Style="{StaticResource SectionLabel}" Margin="0,17,0,7"/>
                <TextBox x:Name="NameBox" Height="36"/>

                <TextBlock Text="COLOUR" Style="{StaticResource SectionLabel}" Margin="0,17,0,7"/>
                <WrapPanel x:Name="Swatches"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Padding="18,8" Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Style="{StaticResource AccentButton}" Content="Create" Margin="9,0,0,0"
                            Padding="24,8" Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
