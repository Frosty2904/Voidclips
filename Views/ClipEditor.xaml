<Window x:Class="VoidClip.Views.ClipEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:VoidClip.Controls"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Width="900" Height="790"
        MinWidth="720" MinHeight="620"
        Background="Transparent" AllowsTransparency="True"
        TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="13" Background="{StaticResource AppBackdrop}" BorderBrush="{StaticResource Purple}"
            BorderThickness="1" Effect="{StaticResource PanelShadow}" Margin="12">
        <Grid>
            <Rectangle Fill="{StaticResource PurpleBloom}" Opacity="0.5" IsHitTestVisible="False"
                       RadiusX="13" RadiusY="13" HorizontalAlignment="Left" Width="600"/>
            <Rectangle Fill="{StaticResource RedBloom}" Opacity="0.45" IsHitTestVisible="False"
                       RadiusX="13" RadiusY="13" HorizontalAlignment="Right" Width="520"
                       VerticalAlignment="Bottom" Height="420"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ HEADER ═══ -->
                <Border Grid.Row="0" MouseLeftButtonDown="Header_Drag" Background="Transparent" Padding="22,18,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Height="3" CornerRadius="2" Background="{StaticResource AccentGradientWide}"
                                    HorizontalAlignment="Left" Width="46" Margin="0,0,0,11"/>
                            <TextBlock Text="EDIT CLIP" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="HeaderName" Style="{StaticResource H1}" Text="Clip"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource TitleBarButton}" Content="&#xE8BB;"
                                VerticalAlignment="Top" Click="Cancel_Click"/>
                    </Grid>
                </Border>

                <!-- ═══ BODY ═══ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16,14,0">
                    <StackPanel>
                        <!-- name -->
                        <TextBlock Text="NAME" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="NameBox" Height="36" TextChanged="Name_Changed"/>

                        <!-- waveform -->
                        <Grid Margin="0,20,0,0">
                            <TextBlock Text="SELECTION" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock x:Name="SelectionInfo" Style="{StaticResource Hint}" HorizontalAlignment="Right"
                                       Margin="0,-2,0,0"/>
                        </Grid>
                        <Border Margin="0,8,0,0" CornerRadius="10" Background="#B30B0813"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="10,12">
                            <ctrl:WaveformView x:Name="Wave" Height="146" Interactive="True"/>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,7,0,0"
                                   Text="Drag the red handles to set in/out points · click anywhere to move the playhead"/>

                        <!-- transport -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="PlayBtn" Style="{StaticResource AccentButton}" Click="Play_Click" Padding="18,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="PlayLabel" Text="Preview selection" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="Select all" Margin="8,0,0,0"
                                    Padding="14,9" Click="SelectAll_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Crop to selection" Margin="8,0,0,0"
                                    Padding="14,9" Click="Crop_Click"
                                    ToolTip="Permanently discard everything outside the handles"/>
                            <Button Style="{StaticResource GhostButton}" Content="Undo edits" Margin="8,0,0,0"
                                    Padding="14,9" Click="Revert_Click"/>
                        </StackPanel>

                        <!-- processing -->
                        <TextBlock Text="AUDIO" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
                        <Border CornerRadius="10" Background="#4D0B0813" BorderBrush="{StaticResource StrokeSoft}"
                                BorderThickness="1" Padding="15,13">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Playback gain" Style="{StaticResource Body}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="GainSlider" Minimum="0" Maximum="2" Value="1"
                                            ValueChanged="Gain_Changed" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="GainLabel" Text="100%" Style="{StaticResource Hint}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fade in" Style="{StaticResource Body}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="FadeInSlider" Minimum="0" Maximum="1000" Value="0"
                                            ValueChanged="Fade_Changed" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="FadeInLabel" Text="0 ms" Style="{StaticResource Hint}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fade out" Style="{StaticResource Body}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="FadeOutSlider" Minimum="0" Maximum="2000" Value="0"
                                            ValueChanged="Fade_Changed" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="FadeOutLabel" Text="0 ms" Style="{StaticResource Hint}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Normalise" Padding="14,8"
                                            Click="Normalise_Click" ToolTip="Lift the loudest peak up to −1.5 dBFS"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Trim silence" Margin="8,0,0,0"
                                            Padding="14,8" Click="TrimSilence_Click"
                                            ToolTip="Cut the dead air off both ends"/>
                                    <CheckBox x:Name="LoopChk" Content="Loop when fired" Margin="16,0,0,0"
                                              VerticalAlignment="Center" Click="Loop_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- organisation -->
                        <TextBlock Text="ORGANISATION" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Category" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CategoryBox" SelectionChanged="Category_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hotkey" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                <Button x:Name="HotkeyBtn" Style="{StaticResource GhostButton}" Height="34"
                                        Content="Not set" Click="Hotkey_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="MetaLine" Style="{StaticResource Hint}" Margin="0,16,0,20"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ FOOTER ═══ -->
                <Border Grid.Row="2" Background="#800B0813" BorderBrush="{StaticResource StrokeSoft}"
                        BorderThickness="0,1,0,0" Padding="22,13" CornerRadius="0,0,12,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource GhostButton}" Content="Export MP3" Padding="15,8"
                                    Click="ExportMp3_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Export OGG" Margin="8,0,0,0"
                                    Padding="15,8" Click="ExportOgg_Click"/>
                            <Button Style="{StaticResource DangerButton}" Content="Delete clip" Margin="8,0,0,0"
                                    Padding="15,8" Click="Delete_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="Cancel" Padding="18,8"
                                    Click="Cancel_Click"/>
                            <Button Style="{StaticResource AccentButton}" Content="Save clip" Margin="9,0,0,0"
                                    Padding="26,8" Click="Save_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
